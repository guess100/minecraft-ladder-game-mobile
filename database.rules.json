{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{5}$/)",
        ".write": "$code.matches(/^[A-Z0-9]{5}$/)",
        "host": {
          ".validate": "newData.hasChildren(['sid'])"
        },
        "clients": {
          "$c": { ".validate": "newData.isBoolean()" }
        },
        "toHost": {
          "$m": {
            ".validate": "newData.child('from').isString() && newData.child('j').isString() && newData.child('j').val().length < 4000"
          }
        },
        "toClient": {
          "$c": {
            "$m": { ".validate": "newData.child('j').isString() && newData.child('j').val().length < 40000" }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
